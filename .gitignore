# Local runtime data and credentials
.env
# Кэш признаков RDKit: минуты счёта, десятки мегабайт, восстанавливается сам.
data/interim/features_cache.npz

# Артефакты обучения и кэш HTTP: тяжёлые, восстанавливаются прогоном.
# Данные в data/ коммитятся — собранная база входит в сдачу.
# artifacts/*.joblib коммитятся намеренно: обучение идёт на маке,
# а сборка сабмита и отправка — на машине с данными соревнования.
data/raw/.http_cache*
reports/submission.csv
reports/metrics.json
reports/*test_diagnostics*.json
reports/*test_diagnostics*.csv
.kaggle/kaggle.json

# Данные соревнования не перераспространяем: качаются через
# python -m src.pipeline kaggle
data/raw/kaggle/

